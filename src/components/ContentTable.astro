---
interface Props { headers: string[]; rows: Array<Array<string | number>>; caption?: string; align?: Array<'l' | 'r'>; highlightRow?: number }
const { headers, rows, caption, align = [], highlightRow = -1 } = Astro.props;
---
<div class="overflow-x-auto">
  <table class="w-full text-sm">
    {caption && <caption class="mb-2 text-left text-sm text-navy-500">{caption}</caption>}
    <thead>
      <tr>{headers.map((h, i) => <th scope="col" class={`border-b border-navy-200 bg-navy-50 px-3 py-2 font-semibold text-navy-900 ${align[i] === 'r' ? 'text-right' : 'text-left'}`}>{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r, ri) => (
        <tr class={ri === highlightRow ? 'bg-accent-50 font-semibold' : ri % 2 ? 'bg-navy-50/40' : ''}>
          {r.map((c, i) => <td class={`tabular-nums border-b border-navy-100 px-3 py-2 text-navy-700 ${align[i] === 'r' ? 'text-right' : 'text-left'}`}>{c}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
