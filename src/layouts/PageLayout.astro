---
import { LANG_TAGS as __LT } from '../data/site-config';
import { displayDate } from '../lib/format';
import BaseLayout from './BaseLayout.astro';
import { YEAR, LAST_UPDATED, AUTHOR_NAME, AUTHOR_ROLE } from '../data/site-config';
import { t } from '../i18n/ui';
import { route, type Locale } from '../i18n/routes';
import type { FAQItem } from '../lib/seo';
interface BreadcrumbItem { label: string; href?: string }
interface Props { title: string; description: string; lang: Locale; canonical?: string; ogImage?: string; noindex?: boolean; jsonLd?: string[]; related?: Array<{ href: string; name: string; description: string }>; faqs?: FAQItem[]; sources?: Array<{ name: string; url: string }>; breadcrumbs?: BreadcrumbItem[]; showAuthor?: boolean }
const { title, description, lang, canonical, ogImage, noindex = false, jsonLd = [], related = [], faqs = [], sources = [], breadcrumbs = [], showAuthor = true } = Astro.props;
const ui = t(lang);
---
<BaseLayout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <p data-chrome class="mb-6 border-b border-navy-100 pb-3 text-sm text-navy-500">
      {ui.updatedOn} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time>
    </p>
    <slot />
    {faqs.length > 0 && (<section class="mt-12" id="faq"><h2 class="mb-6 text-2xl font-bold text-navy-900">{ui.faqTitle}</h2><div class="space-y-3">
      {faqs.map((faq) => (<details class="group rounded-lg border border-navy-200 bg-white"><summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-medium text-navy-900">{faq.q}<svg class="h-5 w-5 shrink-0 text-navy-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" /></svg></summary><div class="px-5 pb-4 text-navy-600"><p>{faq.a}</p></div></details>))}
    </div></section>)}
    {related.length > 0 && (<section class="mt-12" data-chrome><h2 class="mb-6 text-2xl font-bold text-navy-900">{ui.relatedCalculators}</h2><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((r) => (<a href={r.href} class="rounded-lg border border-navy-200 p-4 transition-colors hover:border-accent-300 hover:bg-accent-50"><h3 class="font-semibold text-navy-900">{r.name}</h3><p class="mt-1 text-sm text-navy-500">{r.description}</p></a>))}
    </div></section>)}
    {sources.length > 0 && (<section class="mt-12" data-chrome><h2 class="mb-4 text-lg font-semibold text-navy-900">{ui.sourcesTitle}</h2><ul class="list-disc pl-5 text-sm text-navy-600">{sources.map((s) => <li><a href={s.url} target="_blank" rel="nofollow noopener noreferrer" class="hover:text-accent-600">{s.name}</a></li>)}</ul></section>)}
    {showAuthor && (<div data-chrome data-author={AUTHOR_NAME} class="mt-10 flex items-center gap-4 rounded-lg border border-navy-200 bg-navy-50 px-5 py-4"><div class="text-sm"><p class="font-semibold text-navy-900">{ui.writtenBy} <a rel="author" href={route('about', lang)} class="text-accent-600 hover:underline">{AUTHOR_NAME}</a></p><p class="text-navy-500">{AUTHOR_ROLE[lang]}</p><p class="mt-1 text-navy-500">{ui.updatedOn} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time> · <a href={route('editorial', lang)} class="text-accent-600 hover:underline">{ui.editorialPolicy}</a> · <a href={route('contact', lang)} class="text-accent-600 hover:underline">{ui.contactLabel}</a></p></div></div>)}
    <p data-chrome class="mt-4 text-sm text-navy-500">{ui.asOf} {YEAR}, {ui.lastUpdated} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, __LT[lang])}</time></p>
  </div>
</BaseLayout>
